# Default reviewers and approvers for API changes
reviewers:
  - api-reviewers
approvers:
  - api-approvers

# File-specific ownership patterns
filters:
  # Dependency files at any level - require different approval
  "(^|.*/)go\\.(mod|sum)$":
    reviewers:
      - sustaining-reviewers
    approvers:
      - sustaining-approvers
      - api-approvers

  # Vendor directory changes at any level
  "(^|.*/)vendor/.*":
    reviewers:
      - sustaining-reviewers
    approvers:
      - sustaining-approvers
      - api-approvers
